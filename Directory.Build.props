<Project>
  <!-- Shared settings for every project of the solution -->
  <PropertyGroup>
    <!-- Default version for local builds. The release workflow overrides it from the git tag (-p:Version=x.y.z). -->
    <Version>0.1.0</Version>
    <Product>HotkeyLauncher</Product>
    <Authors>Jean-Pierre Planas</Authors>
    <Copyright>Copyright © 2026 Jean-Pierre Planas</Copyright>
    <RepositoryUrl>https://github.com/sybaris/HotkeyLauncher</RepositoryUrl>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Only ship English (neutral) and French resources, also for third-party packages -->
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
