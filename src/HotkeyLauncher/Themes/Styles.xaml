<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:HotkeyLauncher.Views"
                    xmlns:vm="clr-namespace:HotkeyLauncher.ViewModels">

    <v:VisibleWhenConverter x:Key="VisibleWhen" />
    <v:GroupNameConverter x:Key="GroupName" />

    <!-- ===== Brand (same colors as the logo) ===== -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#8B5CF6" />
        <GradientStop Offset="1" Color="#258CF4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandVerticalGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#8B5CF6" />
        <GradientStop Offset="1" Color="#258CF4" />
    </LinearGradientBrush>
    <!-- Translucent brand tint, readable on light and dark themes -->
    <LinearGradientBrush x:Key="BrandSoftBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#338B5CF6" />
        <GradientStop Offset="1" Color="#33258CF4" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnBrandBrush" Color="White" />
    <SolidColorBrush x:Key="OnBrandSecondaryBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="OnBrandChipBrush" Color="#2EFFFFFF" />

    <!-- Lightning bolt of the logo, used as a decoration -->
    <Geometry x:Key="BoltGeometry">M 64,0 L 8,58 L 46,58 L 34,100 L 92,40 L 54,40 Z</Geometry>

    <!-- Gradient banner at the top of the windows -->
    <Style x:Key="BrandBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Rounded pill displayed on the banners -->
    <Style x:Key="BannerChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OnBrandChipBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="BannerKeyCapTemplate">
        <Border Margin="0,0,5,0"
                Padding="9,3,9,4"
                MinWidth="28"
                Background="{StaticResource OnBrandChipBrush}"
                BorderBrush="#66FFFFFF"
                BorderThickness="1,1,1,2"
                CornerRadius="6">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OnBrandBrush}"
                       Text="{Binding}" />
        </Border>
    </DataTemplate>

    <!-- Card used for sections and list rows -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,14" />
    </Style>

    <!-- Section header of a card: tinted round icon + title -->
    <Style x:Key="SectionIconBadge" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{StaticResource BrandGradientBrush}" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Section title inside pages and dialogs -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,18,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- A key cap, used to display a hotkey such as [Ctrl] [Alt] [N] -->
    <DataTemplate x:Key="KeyCapTemplate">
        <Border Margin="0,0,4,0"
                Padding="7,2,7,3"
                MinWidth="24"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1,1,1,2"
                CornerRadius="5">
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Text="{Binding}" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="LargeKeyCapTemplate">
        <Border Margin="0,0,6,0"
                Padding="12,5,12,6"
                MinWidth="36"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="1,1,1,3"
                CornerRadius="7">
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding}" />
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="HorizontalPanel">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- ===== On-screen keyboard ===== -->

    <!-- Keyboard body: solid case with a strong outline and a soft shadow -->
    <Style x:Key="KeyboardCase" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.25" ShadowDepth="4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A key in relief: an "edge" (darker, thicker at the bottom like a real key cap)
        around a solid "face". The state color (Background) is laid over the face.
    -->
    <Style x:Key="KeyboardKeyStyle" TargetType="Button">
        <Setter Property="Width" Value="{Binding Width}" />
        <Setter Property="Height" Value="{x:Static vm:KeyViewModel.Height}" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Edge"
                            Padding="0,0,0,3"
                            Background="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            CornerRadius="6">
                        <Border x:Name="Face"
                                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Image Width="12"
                                           Height="12"
                                           Margin="0,0,2,2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Source="{Binding OwnerIcon}" />
                                </Grid>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                        <!-- Pressed: the key goes down -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Edge" Property="Padding" Value="0,2,0,1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Selected">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="ModifierOn">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="ModifierOff">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="UsedByShortcut">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Taken">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </DataTrigger>
            <!-- Tab, Caps Lock, Enter...: drawn as real keys, but dimmed and not clickable -->
            <DataTrigger Binding="{Binding State}" Value="Decorative">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Spacer">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Small colored square used in the keyboard legend -->
    <Style x:Key="LegendSwatch" TargetType="Border">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
