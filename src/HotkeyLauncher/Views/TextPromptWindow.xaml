<ui:FluentWindow x:Class="HotkeyLauncher.Views.TextPromptWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:HotkeyLauncher.Localization"
                 Width="440"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar x:Name="TitleBar" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,4,24,20">
            <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="InputBox" />
            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button MinWidth="100" Content="{l:Tr Common_Cancel}" IsCancel="True" />
                <ui:Button MinWidth="100" Margin="8,0,0,0" Appearance="Primary" Content="{l:Tr Common_Ok}" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
